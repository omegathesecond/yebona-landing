{
  "name": "yebona-landing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run seo:prepare && node scripts/generate-sitemap.mjs",
    "build": "vite build && vite build --ssr seo/entry.tsx --outDir dist-seo && npm run seo:build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:before-seo": "vite build",
    "seo:build": "node node_modules/@omevision/static-seo/site.mjs",
    "postbuild": "node analytics/build.mjs",
    "seo:prepare": "node node_modules/@omevision/static-seo/site.mjs --prepare"
  },
  "dependencies": {
    "dompurify": "^3.4.8",
    "lucide-react": "^0.563.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.1",
    "@omevision/static-seo": "file:vendor/omevision-static-seo-0.3.0.tgz"
  }
}
